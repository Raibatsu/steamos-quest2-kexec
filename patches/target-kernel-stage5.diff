diff --git a/drivers/gpu/msm/adreno_a6xx_gmu.c b/drivers/gpu/msm/adreno_a6xx_gmu.c
index 758cd13f..e3f96c48 100644
--- a/drivers/gpu/msm/adreno_a6xx_gmu.c
+++ b/drivers/gpu/msm/adreno_a6xx_gmu.c
@@ -1055,6 +1055,27 @@ static int a6xx_gmu_fw_start(struct kgsl_device *device,
 		/* Turn on TCM retention */
 		gmu_core_regwrite(device, A6XX_GMU_GENERAL_7, 1);
 
+		/*
+		 * Across a kexec jump from Horizon OS, the GPU RSC and PDC
+		 * hardware sequencer may still be parked in the sleep state
+		 * (RSC_STATUS0 BIT(16) / SEQ_BUSY != 0) from Horizon's last
+		 * slumber transition even though kernel flags start at 0.
+		 * Wake the RSC sequencer first so its RPMh interface is active
+		 * and the sequencer is idle before reloading RSC/PDC uCode.
+		 */
+		if (adreno_dev->rscc_virt &&
+		    ((__raw_readl(adreno_dev->rscc_virt +
+				  (A6XX_GPU_RSCC_RSC_STATUS0_DRV0 << 2)) &
+		      BIT(16)) ||
+		     __raw_readl(adreno_dev->rscc_virt +
+				 (A6XX_RSCC_SEQ_BUSY_DRV0 << 2)))) {
+			set_bit(GMU_RSCC_SLEEP_SEQ_DONE,
+				&device->gmu_core.flags);
+			ret = a6xx_rpmh_power_on_gpu(device);
+			if (ret)
+				return ret;
+		}
+
 		if (!test_and_set_bit(GMU_BOOT_INIT_DONE,
 			&device->gmu_core.flags))
 			ret = _load_gmu_rpmh_ucode(device);
