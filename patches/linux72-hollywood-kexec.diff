diff --git a/drivers/soc/qcom/qcom_aoss.c b/drivers/soc/qcom/qcom_aoss.c
index 259c41f0c..296939696 100644
--- a/drivers/soc/qcom/qcom_aoss.c
+++ b/drivers/soc/qcom/qcom_aoss.c
@@ -646,6 +646,28 @@ static void qmp_remove(struct platform_device *pdev)
 	mbox_free_channel(qmp->mbox_chan);
 }
 
+static void qmp_shutdown(struct platform_device *pdev)
+{
+	struct qmp *qmp = platform_get_drvdata(pdev);
+	int ret;
+
+	if (!qmp)
+		return;
+
+	writel(QMP_STATE_DOWN, qmp->msgram + QMP_DESC_MCORE_CH_STATE);
+	qmp_kick(qmp);
+	ret = wait_event_timeout(qmp->event,
+				 readl(qmp->msgram + QMP_DESC_UCORE_CH_STATE) == QMP_STATE_DOWN,
+				 HZ / 2);
+	if (ret) {
+		writel(QMP_STATE_DOWN, qmp->msgram + QMP_DESC_UCORE_CH_STATE_ACK);
+		qmp_kick(qmp);
+		wait_event_timeout(qmp->event,
+				   readl(qmp->msgram + QMP_DESC_MCORE_CH_STATE_ACK) == QMP_STATE_DOWN,
+				   HZ / 2);
+	}
+}
