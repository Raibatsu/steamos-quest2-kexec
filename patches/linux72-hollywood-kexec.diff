diff --git a/drivers/spmi/spmi-pmic-arb.c b/drivers/spmi/spmi-pmic-arb.c
index 2e2cb4774..b6e824811 100644
--- a/drivers/spmi/spmi-pmic-arb.c
+++ b/drivers/spmi/spmi-pmic-arb.c
@@ -2018,6 +2018,26 @@ static int spmi_pmic_arb_bus_init(struct platform_device *pdev,
 	if (ret)
 		return ret;
 
+	/* Quiesce APPS-owned SPMI APIDs inherited across kexec before chaining IRQ */
+	{
+		u16 ppid, apid;
+
+		for (ppid = 0; ppid < PMIC_ARB_MAX_PPID; ppid++) {
+			apid = bus->ppid_to_apid[ppid];
+			if (!(apid & PMIC_ARB_APID_VALID))
+				continue;
+			apid &= ~PMIC_ARB_APID_VALID;
+			if (apid < bus->base_apid ||
+			    apid >= bus->base_apid + bus->apid_count)
+				continue;
+			if (bus->apid_data[apid].irq_ee == pmic_arb->ee &&
+			    bus->apid_data[apid].write_ee == pmic_arb->ee) {
+				writel_relaxed(0, pmic_arb->ver_ops->acc_enable(bus, apid));
+				writel_relaxed(~0U, pmic_arb->ver_ops->irq_clear(bus, apid));
+			}
+		}
+	}
+
 	dev_dbg(&pdev->dev, "adding irq domain for bus %d\n", bus_index);
 
 	bus->domain = irq_domain_create_tree(of_fwnode_handle(node), &pmic_arb_irq_domain_ops, bus);
