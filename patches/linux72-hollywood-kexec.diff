--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -606,8 +606,19 @@ static int a6xx_rpmh_start(struct a6xx_gmu *gmu)
 	int ret;
 	u32 val;
 
-	if (!test_and_clear_bit(GMU_STATUS_PDC_SLEEP, &gmu->status))
-		return 0;
+	if (!test_and_clear_bit(GMU_STATUS_PDC_SLEEP, &gmu->status)) {
+		/*
+		 * Across kexec from Horizon OS, the GPU RSC/PDC sequencer may
+		 * still be parked in sleep (RSC_STATUS0 BIT(16) or SEQ_BUSY != 0)
+		 * even though GMU_STATUS_PDC_SLEEP starts clear. Wake it before
+		 * loading and starting the GMU firmware.
+		 */
+		if (!gmu->rscc ||
+		    !((gmu_read_rscc(gmu, REG_A6XX_GPU_RSCC_RSC_STATUS0_DRV0) & BIT(16)) ||
+		      gmu_read_rscc(gmu, REG_A6XX_RSCC_SEQ_BUSY_DRV0)))
+			return 0;
+		DRM_DEV_INFO(gmu->dev, "Waking GPU RSC parked in sleep across kexec\n");
+	}
 
 	gmu_write(gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, BIT(1));
 
