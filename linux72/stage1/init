#!/bin/busybox sh
# Stage 1 on the 7.2 kernel: kexec-adapted shell over USB (NCM network, telnet on
# 10.42.0.2:23, ACM serial console), kernel log in /run/dmesg.txt and pstore.
# Only modem_b/modem_a is mounted read-only to stage a650_zap.*. Nothing is written.
export PATH=/bin:/sbin
export HOME=/root
export TERM=vt100
/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /run /tmp /root /sys/kernel/config
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mkdir -p /sys/fs/pstore && mount -t pstore pstore /sys/fs/pstore 2>/dev/null
echo 65536 > /proc/sys/vm/min_free_kbytes 2>/dev/null
echo 30 > /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null

log() { echo "stage1: $*" > /dev/kmsg; }
log "up, kernel $(uname -r)"

ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null

UDC=""
n=0
while [ $n -lt 100 ] && [ -z "$UDC" ]; do
  UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
  [ -n "$UDC" ] || { sleep 0.2; n=$((n + 1)); }
done

G=/sys/kernel/config/usb_gadget/q2
if [ -n "$UDC" ]; then
  mkdir -p $G && cd $G
  echo 0x1d6b > idVendor; echo 0x0104 > idProduct
  mkdir -p strings/0x409 configs/c.1/strings/0x409 functions/ecm.usb0 functions/acm.usb0
  echo "Quest 2 stage 1" > strings/0x409/product
  echo hollywood > strings/0x409/serialnumber
  echo "ECM+ACM" > configs/c.1/strings/0x409/configuration
  echo 02:51:4b:58:00:01 > functions/ecm.usb0/host_addr
  echo 02:51:4b:58:00:02 > functions/ecm.usb0/dev_addr
  echo 16 > functions/ecm.usb0/qmult 2>/dev/null
  ln -s functions/ecm.usb0 configs/c.1/ 2>/dev/null
  ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
  echo "$UDC" > UDC
  cd /
  echo on > "/sys/class/udc/$UDC/device/../power/control" 2>/dev/null
  log "USB gadget on $UDC"
else
  log "no USB device controller"
fi

n=0
while [ $n -lt 50 ] && ! ip link show usb0 >/dev/null 2>&1; do sleep 0.2; n=$((n + 1)); done
ip addr add 10.42.0.2/24 dev usb0 2>/dev/null
ip link set usb0 up 2>/dev/null || ifconfig usb0 10.42.0.2 netmask 255.255.255.0 up 2>/dev/null
telnetd -l /bin/sh -b 10.42.0.2
( while [ -x /bin/dmesg ]; do dmesg > /run/dmesg.txt 2>/dev/null; sleep 2; done ) &
( while [ -x /bin/sh ]; do [ -e /dev/ttyGS0 ] && setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done ) &
log "usb0 $(ip -br addr show usb0 2>/dev/null | tr '\n' ' ') telnet on 10.42.0.2:23"

part() { for p in /sys/class/block/*; do grep -q "^PARTNAME=$1\$" "$p/uevent" 2>/dev/null && { echo "/dev/${p##*/}"; return; }; done; }
n=0
while [ $n -lt 50 ] && [ -z "$(part modem_b)" ] && [ -z "$(part modem_a)" ]; do sleep 0.2; n=$((n + 1)); done
mkdir -p /mnt/modem /lib/firmware/qcom/sm8250/hollywood
for slot in modem_b modem_a; do
  M=$(part "$slot")
  if [ -n "$M" ] && mount -t vfat -o ro "$M" /mnt/modem 2>/dev/null; then
    cp /mnt/modem/image/a650_zap.* /lib/firmware/qcom/sm8250/hollywood/ 2>/dev/null
    umount /mnt/modem
    log "copied a650_zap from $slot ($M ro)"
    break
  fi
done
log "GPU firmware: $(ls /lib/firmware/qcom /lib/firmware/qcom/sm8250/hollywood 2>/dev/null | tr '\n' ' ')"
while true; do
  [ -x /run/stage2.sh ] && exec /run/stage2.sh
  sleep 1
done
