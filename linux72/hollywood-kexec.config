# Kexec adjustments over gabe_defconfig + hollywood.config
# Disable DWARF/BTF debug info (saves ~5-8 MiB inside Image and speeds up build)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# Keep ECM alongside NCM as USB gadget fallback
CONFIG_USB_CONFIGFS_ECM=y
# Shrink printk ring buffer from gabe_defconfig's 16 MiB (72 MiB static data+bss) to 256 KiB
CONFIG_LOG_BUF_SHIFT=18
# Drop unused enterprise/network filesystems so Image + initramfs + DTB fit comfortably under 64 MiB
# CONFIG_XFS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_AF_RXRPC is not set
# Enable native Linux -> Linux kexec (no Horizon OS reboot / Singularity root needed for future iterations)
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
# Expose /dev/fb0 for fbdev inspection/testing
CONFIG_FB_DEVICE=y
# PM8150L LCDB +/-5.7V LCD bias regulator for Quest 2 display
CONFIG_REGULATOR_QCOM_PM8150L_LCDB=y
