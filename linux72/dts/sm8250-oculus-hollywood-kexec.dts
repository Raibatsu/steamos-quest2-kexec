/*
 * Meta Quest 2 (hollywood) kexec target over sm8250-oculus-hollywood.dts.
 * - Populates /memory@80000000 with Horizon OS's exact 6 GiB banks (ABL bypassed).
 * - Marks Horizon OS's active TZ/HYP-protected regions no-map across kexec.
 * - Matches Horizon OS's ramoops console-size (0x20000) so Horizon /sys/fs/pstore
 *   can read Linux 7.2 logs after a warm reboot/panic.
 * - Supplies kexec bootargs (panic=5 for automatic pstore-preserving warm reboot).
 */

#include "sm8250-oculus-hollywood.dts"

/ {
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x3cc00000>,
		      <0x0 0xc0000000 0x1 0x40000000>;
	};

	chosen {
		bootargs = "rdinit=/init clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=5 reboot=w irqchip.gicv3_pseudo_nmi=1 nmi_watchdog=panic loglevel=7 printk.devkmsg=on console=tty0 fbcon=font:TER16x32 fbcon=rotate:3 drm_client_lib.active=fbdev";
	};

	reserved-memory {
		ramoops@9ba00000 {
			console-size = <0x20000>;
		};

		res_xbl_uefi_log_region@80880000 {
			reg = <0x0 0x80880000 0x0 0x14000>;
			no-map;
		};

		/*
		 * Horizon OS reserves 0xec800000..0xffc1ffff contiguously for
		 * secure_display, user_contig, sdsp, qseecom_ta, cnss_wlan
		 * (XPU-locked to VMID_WLAN), sp, cdsp, adsp, qseecom, cma,
		 * and mailbox. Mark the entire range no-map so Linux 7.2
		 * (including SWIOTLB and buddy pages) never touches an
		 * XPU/MSA-protected physical address across kexec.
		 */
		horizon_tz_cma_region@ec800000 {
			reg = <0x0 0xec800000 0x0 0x13420000>;
			no-map;
		};
	};
};

&apps_rsc {
	regulators-0 {
		vreg_l14a_1p8: ldo14 {
			regulator-name = "vreg_l14a_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8150l-rpmh-regulators";
		qcom,pmic-id = "c";

		vreg_l7c_3p0: ldo7 {
			regulator-name = "vreg_l7c_3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l8c_1p8: ldo8 {
			regulator-name = "vreg_l8c_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l11c_3p3: ldo11 {
			regulator-name = "vreg_l11c_3p3";
			regulator-min-microvolt = <3296000>;
			regulator-max-microvolt = <3312000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&spmi_bus {
	pmic@4 {
		compatible = "qcom,pm8150l", "qcom,spmi-pmic";
		reg = <0x4 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	pmic@5 {
		compatible = "qcom,pm8150l", "qcom,spmi-pmic";
		reg = <0x5 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8150l_lcdb: lcdb@ec00 {
			compatible = "qcom,pm8150l-lcdb";
			reg = <0xec00>;
			regulator-name = "pm8150l_lcdb";
			regulator-min-microvolt = <5700000>;
			regulator-max-microvolt = <5700000>;
		};
	};
};

&mdss_dsi0 {
	panel@0 {
		vddio-supply = <&vreg_l14a_1p8>;
		lcdb-supply = <&pm8150l_lcdb>;
		blu-mcu-supply = <&vreg_l11c_3p3>;
	};
};

&tlmm {
	syncboss_pins: syncboss-default-state {
		reset-pins {
			pins = "gpio5";
			function = "gpio";
			drive-strength = <6>;
			output-low;
		};

		wakeup-pins {
			pins = "gpio4";
			function = "gpio";
			bias-pull-down;
			input-enable;
		};

		timesync-pins {
			pins = "gpio7";
			function = "gpio";
			bias-pull-down;
			input-enable;
		};
	};
};

&gpi_dma2 {
	status = "okay";
};

&qupv3_id_2 {
	status = "okay";
};

&spi19 {
	pinctrl-names = "default";
	pinctrl-0 = <&qup_spi19_data_clk &qup_spi19_cs>;
	status = "okay";

	syncboss@0 {
		compatible = "oculus,syncboss";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cpha;
		pinctrl-names = "default";
		pinctrl-0 = <&syncboss_pins>;

		reset-gpios = <&tlmm 5 GPIO_ACTIVE_HIGH>;
		ready-gpios = <&tlmm 4 GPIO_ACTIVE_HIGH>;
		timesync-gpios = <&tlmm 7 GPIO_ACTIVE_HIGH>;
		nsync-gpios = <&tlmm 66 GPIO_ACTIVE_HIGH>;

		oculus,mcu-core-supply = <&vreg_s4a_1p8>;
		oculus,mcu-core-voltage-level = <1800000 1800000>;
		oculus,imu-core-supply = <&vreg_l7c_3p0>;
		oculus,imu-core-voltage-level = <3000000 3000000>;
		oculus,mag-core-supply = <&vreg_l8c_1p8>;
		oculus,mag-core-voltage-level = <1800000 1800000>;

		oculus,syncboss-has-prox;
	};
};
